# Built from the **site root** (one level up), so the image contains both the
# site and the server:
#
#   docker build -t alder-house -f server/Dockerfile .
#   docker run -p 8080:8080 --env-file server/.env alder-house
#
FROM node:22-alpine

WORKDIR /app
COPY . /app/

ENV NODE_ENV=production \
    PORT=8080 \
    SITE_ROOT=/app

EXPOSE 8080
CMD ["node", "server/server.js"]
