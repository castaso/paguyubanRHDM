# Copy to .env and fill in. Never commit the real .env.

# ── Google OAuth ────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
#   Application type: Web application
#   Authorised redirect URI: must match OAUTH_REDIRECT_URI below, exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8787/auth/google/callback

# ── Session cookie ──────────────────────────────────────────────────────
# Any long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_COOKIE=alder_session
SESSION_TTL_SECONDS=1209600
# Set to 1 when served over HTTPS (required in production).
SECURE_COOKIES=0

# ── Access control (RBAC) ───────────────────────────────────────────────
# Comma-separated. Only these Google accounts may sign in.
ALLOWED_EMAILS=paguyubanRHDM@gmail.com,castasoft@gmail.com

# ── Supabase (optional) ────────────────────────────────────────────────
# Set these to also accept Supabase access tokens at /api/settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only for HS256-signed (legacy) Supabase projects:
SUPABASE_JWT_SECRET=

# ── Server ──────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
# Static site to serve and protect (defaults to the site root one level up).
SITE_ROOT=..
